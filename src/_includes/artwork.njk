<article class="artwork item-{{ loop.index }}" data-work="{{ work.id }}" x-show="matches('{{ work.id }}')"><div class="art-frame" style="--paper:{{ work.color }}"><a href="{{ ('/obras/' + work.slug + '/') | url }}" aria-label="Conhecer {{ work.title }}, de {{ work.artist }}"><img src="{{ ('/images/' + work.id + '-640.webp') | url }}" srcset="{{ ('/images/' + work.id + '-640.webp') | url }} 640w, {{ ('/images/' + work.id + '-1600.webp') | url }} 1600w" sizes="(max-width:600px) 90vw, (max-width:900px) 45vw, 40vw" width="{{ work.width }}" height="{{ work.height }}" alt="{{ work.alt }}" {% if loop.index > 3 %}loading="lazy"{% else %}fetchpriority="high"{% endif %} decoding="async"></a><button class="save-art" :class="{'is-saved':$store.archive.has('{{ work.id }}')}" @click="$store.archive.toggle('{{ work.id }}')" :aria-label="($store.archive.has('{{ work.id }}')?'Remover da seleção: ':'Guardar na seleção: ')+'{{ work.title }}'" :aria-pressed="$store.archive.has('{{ work.id }}')" x-cloak>{% include 'bookmark.svg' %}</button><span class="frame-index" aria-hidden="true">{{ loop.index | pad }}</span></div><div class="art-label"><div><p class="artist">{{ work.artist }}</p><h2><a href="{{ ('/obras/' + work.slug + '/') | url }}">{{ work.title }}</a></h2><p class="art-date">{{ work.date }} <span>·</span> {{ work.medium }}</p></div><button class="compare-mini" :aria-pressed="$store.archive.compare.includes('{{ work.id }}')" @click="$store.archive.toggleCompare('{{ work.id }}')" aria-label="Comparar {{ work.title }}" title="Adicionar à comparação" x-cloak>⇄</button></div></article>
